@page
@model Web.Pages.MatchesModel
@{
    ViewData["Title"] = "Matches";
}

@{
    ViewData["Title"] = "Matches";
}

<div class="page-header"></div>

<div class="matches-toolbar">
    <div class="tabs">
        <a class="tab @(Model.Tab == null ? "active" : "")" href="/Matches?sort=@Model.Sort&search=@Model.Search">
            All <span class="tab-count">@Model.TotalCount</span>
        </a>
        <a class="tab @(Model.Tab == "Favourites" ? "active" : "")" href="/Matches?tab=Favourites&sort=@Model.Sort&search=@Model.Search">
            Favourites <span class="tab-count">@Model.FavouriteCount</span>
        </a>
        <details class="tab-dropdown">
            <summary class="tab @(Model.PlatformCounts.ContainsKey(Model.Tab ?? "") ? "active" : "")">
                Platforms ▾
            </summary>
            <div class="tab-dropdown-menu">
                @foreach (var (platform, count) in Model.PlatformCounts.OrderBy(p => p.Key))
                {
                    <a class="tab @(Model.Tab == platform ? "active" : "")" 
                       href="/Matches?tab=@platform&sort=@Model.Sort&search=@Model.Search">
                        @platform <span class="tab-count">@count</span>
                    </a>
                }
            </div>
        </details>
        <a class="tab @(Model.Tab == "Dismissed" ? "active" : "")" href="/Matches?tab=Dismissed&sort=@Model.Sort&search=@Model.Search">
            Dismissed
        </a>
    </div>

    <div class="matches-controls">
        <form method="get" style="display:flex; gap:8px;">
            <input type="hidden" name="tab" value="@Model.Tab"/>
            <input type="hidden" name="sort" value="@Model.Sort"/>
            <input type="text" name="search" value="@Model.Search" placeholder="Search matches..." class="search-input"/>
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a href="/Matches?tab=@Model.Tab&sort=@Model.Sort" class="btn btn-danger">✕</a>
            }
        </form>

        <select class="sort-select" onchange="window.location='/Matches?tab=@Model.Tab&search=@Model.Search&sort=' + this.value">
            @{ var sort = Model.Sort ?? ""; }
            <option value="" selected="@(sort == "" ? "selected" : null)">Newest first</option>
            <option value="Oldest" selected="@(sort == "Oldest" ? "selected" : null)">Oldest first</option>
            <option value="PriceLow" selected="@(sort == "PriceLow" ? "selected" : null)">Price low to high</option>
            <option value="PriceHigh" selected="@(sort == "PriceHigh" ? "selected" : null)">Price high to low</option>
        </select>
    </div>
</div>

@if (!Model.Matches.Any())
{
    <div class="empty">No matches found.</div>
}
else
{
    <div class="section-label">@(Model.Tab ?? "All") · @Model.Matches.Count shown</div>
    <div class="matches-panel" style="max-height: 75vh;">
        @foreach (var match in Model.Matches)
        {
            <div class="card match-card-with-thumb">
                @if (!string.IsNullOrEmpty(match.ImageUrl))
                {
                    <img class="match-thumb" src="@match.ImageUrl" alt="@match.ListingTitle"/>
                }
                else
                {
                    <div class="match-thumb match-thumb-placeholder"></div>
                }
                <div class="match-card-content">
                    <div class="match-card-top">
                        <div style="display:flex; align-items:center; gap:8px;">
                            <div class="match-game">@match.WishlistTitle</div>
                            <button class="btn-icon star @(match.IsFavourite ? "active" : "")"
                                    data-listing-id="@match.ListingId"
                                    data-action="favourite"
                                    title="Favourite">★</button>
                        </div>
                        <div class="price-badge">@match.Price kr</div>
                    </div>
                    <div class="match-listing">@match.ListingTitle</div>
                    <div class="match-meta">
                        <div class="match-loc">@match.PostalName · @match.ListingDate?.ToString("dd/MM HH:mm")</div>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <button class="btn-icon dismiss"
                                    data-listing-id="@match.ListingId"
                                    data-action="dismiss"
                                    title="Dismiss">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"></path>
                                    <path d="M10 11v6M14 11v6"></path>
                                    <path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"></path>
                                </svg>
                            </button>
                            <a class="match-link" href="https://www.dba.dk/recommerce/forsale/item/@match.ListingId" target="_blank">view listing →</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}