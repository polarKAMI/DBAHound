@model Core.StoredMatch

<div class="card match-card-with-thumb">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img class="match-thumb" src="@Model.ImageUrl" alt="@Model.ListingTitle"/>
    }
    else
    {
        <div class="match-thumb match-thumb-placeholder"></div>
    }
    <div class="match-card-content">
        <div class="match-card-top">
            <div style="display:flex; align-items:center; gap:8px;">
                <div class="match-game">@Model.WishlistTitle</div>
                <button class="btn-icon star @(Model.IsFavourite ? "active" : "")"
                        data-listing-id="@Model.ListingId"
                        data-action="favourite"
                        title="Favourite">★</button>
            </div>
            <div class="price-badge">@Model.Price kr</div>
        </div>
        <div class="match-listing">@Model.ListingTitle</div>
        <div class="match-meta">
            <div class="match-loc">
                @Model.PostalName · @Model.ListingDate?.ToString("dd/MM HH:mm")
                @if ((bool)(ViewData["AutoCleanupEnabled"] ?? false) && !Model.IsFavourite && !Model.IsDismissed)
                {
                    var expiresIn = (int)(Model.FoundAt.AddDays((int)(ViewData["AutoCleanupDays"] ?? 30)) - DateTime.Now).TotalDays;
                    if (expiresIn >= 0)
                    {
                        var expiryClass = expiresIn <= 3 ? "expiry-urgent" : expiresIn <= 7 ? "expiry-warning" : "expiry";
                        var expiryText = expiresIn == 0 ? "Expires today" : $"Expires in {expiresIn}d";
                        <span class="@expiryClass"> · @expiryText</span>
                    }
                }
            </div>
        </div>
    </div>
</div>