@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <div class="page-title">Recent matches</div>
        <div class="page-sub">Last scan: @(Model.Matches.Any() ? Model.Matches.Max(m => m.FoundAt).ToString("dd/MM HH:mm") : "never")</div>
    </div>
    <form method="post" asp-page-handler="Scrape" id="scrapeForm">
        <button type="submit" class="btn btn-primary" id="scrapeBtn">Run scrape</button>
    </form>
</div>

@if (!Model.Matches.Any())
{
    <div class="empty">No matches yet — run a scrape to start hunting.</div>
}
else
{
    <div class="section-label">Matches</div>
    <div class="matches-panel-wrap">
        <div class="matches-panel" id="matchesPanel">
            @foreach (var match in Model.Matches)
            {
                await Html.RenderPartialAsync("_MatchCard", match, new ViewDataDictionary(ViewData)
                {
                    { "AutoCleanupEnabled", Model.AutoCleanupEnabled },
                    { "AutoCleanupDays", Model.AutoCleanupDays }
                });
            }
        </div>
    </div>
}